{
  "info": {
    "name": "Лабораторная 6. Приборы",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Список без cookie",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/appliances?minPower=100"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "2. Список с cookie из браузера (isOwner)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "sessionId={{sessionId}}"
          }
        ],
        "url": "{{baseUrl}}/api/appliances?minPower=0"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "3. Черновик пользователя",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "sessionId={{sessionId}}"
          }
        ],
        "url": "{{baseUrl}}/api/appliances/draft"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "4. Лента пользователя",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "sessionId={{sessionId}}"
          }
        ],
        "url": "{{baseUrl}}/api/appliances/feed"
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "5. Вход (если нужен отдельно)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"заменить-на-свой-пароль\"\n}"
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    }
  ]
}
